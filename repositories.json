        },
        ".jsx": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".tsx": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".py": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".java": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".md": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".txt": {
          "include": true,
          "chunkStrategy": "line"
        },
        ".json": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".html": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".css": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".scss": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".xml": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".yaml": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".yml": {
          "include": true,
          "chunkStrategy": "semantic"
        }
      }
    }
