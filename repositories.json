{
  "repositories": [
    {
      "path": "/Users/guillaumeb/dev",
      "name": "goali",
      "include": [
        "**/*.js",
        "**/*.ts",
        "**/*.md"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/utopia-flutter/**"
      ],
      "watchMode": true,
      "watchInterval": 60000,
      "chunkSize": 1000,
      "fileTypeConfig": {
        ".py": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".md": {
          "include": true,
          "chunkStrategy": "semantic"
        }
      }
    },
    {
      "path": "/Volumes/SBS/geo_log_book/utopia-flutter",
      "name": "utopia-flutter",
      "include": [
        "**/*"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/build/**",
        "**/dist/**",
        "**/*.min.js",
        "**/*.map",
        "**/package-lock.json",
        "**/yarn.lock"
      ],
      "watchMode": true,
      "watchInterval": 60000,
      "chunkSize": 1000,
      "fileTypeConfig": {
        ".js": {
          "include": true,
          "chunkStrategy": "semantic"
        },
        ".ts": {
          "include": true,
